# ── Instance ──────────────────────────────────────────────────────────────────
# Your domain name (no protocol, no trailing slash)
DOMAIN=yourdomain.com

# Full URL used in emails, federation, etc.
INSTANCE_DOMAIN=https://yourdomain.com

INSTANCE_NAME=Agora

# ── SSL ───────────────────────────────────────────────────────────────────────
# Set to true once you have run setup-ssl.sh and obtained a certificate.
# false = serve plain HTTP on port 80 (useful for local/dev or behind a load balancer)
SSL_ENABLED=false

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host ports the nginx reverse proxy binds. Leave at 80/443 for a normal
# public deployment; change them to run alongside another web server or
# behind an external load balancer / reverse proxy that terminates TLS.
# Note: Let's Encrypt's HTTP-01 challenge (setup-ssl.sh) needs the host
# reachable on port 80, and non-standard ports become part of every
# federated URL, so set INSTANCE_DOMAIN accordingly (e.g. https://host:8443).
HTTP_PORT=80
HTTPS_PORT=443

# ── Auth — CHANGE THIS in production ─────────────────────────────────────────
# Generate with:  openssl rand -hex 64
JWT_SECRET=changeme-use-a-very-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# Read by both the postgres container and the backend's DATABASE_URL — change
# POSTGRES_PASSWORD here (not in docker-compose.yml) before exposing this
# instance to the internet.
POSTGRES_DB=agora
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora
# Host binding for the Postgres container. Defaults to loopback only so the
# database is not exposed to the network. Use a bare port (e.g. 5432) to
# bind all interfaces, or "127.0.0.1:5433" to change the local port.
POSTGRES_PORT=127.0.0.1:5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads

# ── Email (SMTP) — can also be configured in the Admin Panel ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_ENABLED=false

# ── AT Proto / Bluesky search bot (AGORA-216) ──────────────────────────────────
# A dedicated Bluesky account (create one at bsky.app, generate an App
# Password under Settings > Privacy and Security > App Passwords) the
# instance authenticates as solely to call app.bsky.feed.searchPosts, which
# requires a real session unlike every other AT Proto call this app makes.
# Leave blank to leave network-wide Bluesky post search disabled.
ATPROTO_BOT_HANDLE=
ATPROTO_BOT_APP_PASSWORD=

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
